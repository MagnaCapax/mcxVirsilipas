#!/usr/bin/env php
<?php

declare(strict_types=1);

use MagnaCapax\Virsilipas\Config;
use MagnaCapax\Virsilipas\HttpError;
use MagnaCapax\Virsilipas\Ledger;
use MagnaCapax\Virsilipas\Top;

require dirname(__DIR__) . '/src/bootstrap.php';

$usage = <<<'TXT'
Usage: virsilipas <command> [args]
  init                              create the database tables (safe to re-run)
  key-create <ref> [--expires=<when>] [--named] [--json]
                                    create a key for <ref>; prints the key once. --expires: the key
                                    stops working at <when>, +N followed by m, h or d (N 1 to 999999)
                                    or a UTC time YYYY-MM-DDTHH:MM:SSZ. --named: the key carries the
                                    ref, vsk-<ref>-<48 hex> (ref: 1 to 64 of A-Z a-z 0-9 _ -).
                                    --json: one line {"ref", "key", "expires_at", "named"}
  key-rotate <ref>                  replace <ref>'s key (a leaked key) with a plain one; prints the
                                    new key once; the expiry stays
  key-disable <ref>                 refuse all requests for <ref>
  key-enable <ref>                  allow requests for <ref> again
  key-remove <ref>                  remove <ref>'s key for good (balance and history stay; the ref
                                    cannot be used again)
  grant <ref> <credits> <grant_id> [expires_at]
                                    add (or, if negative, remove) credits, once per grant_id;
                                    expires_at (unix seconds) is stored, not enforced
  limit <ref> <name> <N|default>    set a key's max_concurrent, requests_per_minute or
                                    credits_per_minute; 'default' follows the config again
  bonus <ref> <0..300>              set a key's bonus percent, which raises its priority weight
  group <ref> <name|->              set a key's group for stats (- for none): a-z, 0-9, . _ -
  status <ref>                      show balance, holds, limits and the last minute's use
  history <ref> [N]                 show the last N credit changes (default 100), newest first
  verify                            check every balance against its credit log; exit 1 on a mismatch
  caps                              the server-wide caps in force and their use now: per spend window the
                                    limit, settled cost, cost held by requests running, what remains
                                    (millionths of the upstream unit) and when it resets (unix time);
                                    requests started in the last minute against requests_per_minute
  stats <hour|day|week|month|all|hour_of_day|weekday> [by] [since] [until]
                                    usage over time, one JSON line per UTC bucket and group: requests,
                                    tokens, credits, upstream-reported cost, hang-ups, failures,
                                    requests slowed down, the mean delay, the mean time to first byte
                                    and requests that were retried or failed over;
                                    by = comma list of model,upstream,key,status,source,group (or -); since/until =
                                    YYYY-MM-DD (UTC, until exclusive)
  public-usage <ref-prefix> [file]  the aggregate usage of the keys whose ref starts with ref-prefix,
                                    for publishing (ADR 0023): windows, models, daily, hourly, heatmap;
                                    no ref, count, upstream, cost or grant. With file: written
                                    atomically, mode 0644
  public-top <ref-prefix> [file]    the 10 keys with the most credits used in the last 24 hours, 7 and
                                    30 days, for publishing (ADR 0026): each as an anonymous id (sha256
                                    1000 times over "<ref>:<sha256 of the key>"), credits, requests and
                                    share; no ref or key digest. With file: written atomically, mode 0644
  keys                              list every key: ref, active, balance, group, bonus, created, last
                                    used, removed and expires (unix time), one JSON line each
  key-ref <sha256>                  the ref whose current key has this sha256 hex digest, or null
                                    (a rotated key's old digest, a removed key, or none)
  top [--once] [--interval N]       live view of requests: rate, latency, time to first byte, tokens,
                                    credits, upstream cost, failures, retries, requests in flight and
                                    the caps, refreshed every N seconds (default 2; Ctrl-C quits);
                                    --once prints one view and exits. Metadata only: no prompt or
                                    answer is stored, so none is shown
  --help                            this text
Config: $VIRSILIPAS_CONFIG or ./config.php

TXT;

$args = array_slice($argv, 1);
$cmd = array_shift($args) ?? '';
if (in_array($cmd, ['--help', '-h', 'help'], true)) {
    echo $usage; // before the config is loaded: the usage needs none
    exit(0);
}

try {
    $config = Config::load(virsilipas_config_path());
    $ledger = new Ledger($config->dbPath);
    $out = match ($cmd) {
        'init' => (function () use ($ledger) { $ledger->migrate(); return 'ok'; })(),
        'key-create' => keyCreate($ledger, $args),
        'key-rotate' => $ledger->rotateKey(arg($args, 0)),
        'key-disable' => (function () use ($ledger, $args) { $ledger->setActive(arg($args, 0), false); return 'disabled'; })(),
        'key-enable' => (function () use ($ledger, $args) { $ledger->setActive(arg($args, 0), true); return 'enabled'; })(),
        'key-remove' => json_encode(['ref' => arg($args, 0)] + $ledger->removeKey(arg($args, 0))),
        'grant' => json_encode($ledger->grant(arg($args, 0), arg($args, 2), intArg($args, 1), isset($args[3]) ? intArg($args, 3) : null)),
        'limit' => json_encode($ledger->setLimits(arg($args, 0), [arg($args, 1) => arg($args, 2) === 'default' ? null : intArg($args, 2)])),
        'bonus' => json_encode(['ref' => arg($args, 0), 'bonus_pct' => $ledger->setBonus(arg($args, 0), intArg($args, 1))]),
        'group' => json_encode(['ref' => arg($args, 0), 'key_group' => $ledger->setGroup(arg($args, 0), arg($args, 1) === '-' ? '' : arg($args, 1))]),
        'status' => json_encode($ledger->status(arg($args, 0), $config->limitDefaults())),
        'history' => implode("\n", array_map('json_encode', $ledger->history(arg($args, 0), isset($args[1]) ? intArg($args, 1) : 100))),
        'verify' => verifyOrExit($ledger),
        'caps' => json_encode($ledger->capStatus($config->caps), JSON_FORCE_OBJECT),
        'keys' => implode("\n", array_map('json_encode', $ledger->keys())),
        'key-ref' => json_encode(['ref' => $ledger->refForKeyHash(arg($args, 0))]),
        'public-usage' => publicUsage($ledger, $args),
        'public-top' => publicTop($ledger, $args),
        'top' => top($ledger, $config, $args),
        'stats' => implode("\n", array_map('json_encode', $ledger->stats(arg($args, 0),
            ($args[1] ?? '-') === '-' ? [] : explode(',', $args[1]), dateArg($args, 2), dateArg($args, 3)))),
        default => null,
    };
    if ($out === null) {
        fwrite(STDERR, $usage);
        exit(2);
    }
    echo $out, "\n";
} catch (HttpError | \InvalidArgumentException | \RuntimeException $e) {
    fwrite(STDERR, 'error: ' . $e->getMessage() . "\n");
    exit(1);
}

/**
 * Build the public aggregate usage (ADR 0023); print it, or write it atomically to a file anyone may read.
 * @param list<string> $args
 */
function publicUsage(Ledger $ledger, array $args): string
{
    $now = time();
    $rows = $ledger->stats('hour', ['key', 'model'], $now - 62 * 86400, null);   // 60 days: rolling_30d needs 30 days behind its first point
    $refs = array_column($ledger->keys(), 'ref');
    $json = \MagnaCapax\Virsilipas\PublicUsage::encode(\MagnaCapax\Virsilipas\PublicUsage::build($rows, $now, arg($args, 0)), $refs);
    return publish($json, $args[1] ?? null);
}

/**
 * Build the public top list under anonymous ids (ADR 0026); print it, or write it atomically to a file anyone may read.
 * @param list<string> $args
 */
function publicTop(Ledger $ledger, array $args): string
{
    $now = time();
    $prefix = arg($args, 0);
    $rows = $ledger->stats('hour', ['key', 'model'], $now - 62 * 86400, null);   // 60 days: rolling_30d needs 30 days behind its first point
    $hashes = $ledger->keyHashes($prefix);
    $refs = array_column($ledger->keys(), 'ref');
    $json = \MagnaCapax\Virsilipas\PublicTop::encode(\MagnaCapax\Virsilipas\PublicTop::build($rows, $hashes, $now, $prefix), $refs, $hashes);
    return publish($json, $args[1] ?? null);
}

/** Print $json, or write it to $target through a temporary file and a rename, mode 0644 against the private umask. */
function publish(string $json, ?string $target): string
{
    if ($target === null) {
        return rtrim($json, "\n");
    }
    $tmp = $target . '.tmp-' . getmypid();
    if (file_put_contents($tmp, $json) !== strlen($json) || !chmod($tmp, 0644) || !rename($tmp, $target)) {
        @unlink($tmp);
        throw new \RuntimeException('could not write ' . $target);
    }
    return json_encode(['written' => $target, 'bytes' => strlen($json)]);
}

/**
 * The live view: one render with --once, else a full-screen refresh every --interval seconds until Ctrl-C.
 * @param list<string> $args
 */
function top(Ledger $ledger, Config $config, array $args): string
{
    $interval = 2;
    $i = array_search('--interval', $args, true);
    if ($i !== false) {
        $v = $args[$i + 1] ?? '';
        if (!ctype_digit($v) || (int) $v < 1 || (int) $v > 60) {
            throw new \InvalidArgumentException('--interval must be 1 to 60 seconds');
        }
        $interval = (int) $v;
    }
    if (in_array('--once', $args, true)) {
        return rtrim(Top::render($ledger, $config->caps, time()), "\n");
    }
    while (true) { // @phpstan-ignore while.alwaysTrue
        echo "\033[H\033[2J", Top::render($ledger, $config->caps, time());
        sleep($interval);
    }
}

/**
 * key-create <ref> [--expires=<when>] [--named] [--json]: the bare key by default, as before; one JSON line with --json.
 * @param list<string> $args
 */
function keyCreate(Ledger $ledger, array $args): string
{
    $refs = array_values(array_filter($args, static fn (string $a): bool => !str_starts_with($a, '--')));
    $flags = array_values(array_filter($args, static fn (string $a): bool => str_starts_with($a, '--')));
    $expires = null;
    foreach ($flags as $flag) {
        if (str_starts_with($flag, '--expires=') && $expires === null) {
            $expires = \MagnaCapax\Virsilipas\KeyExpiry::parse(substr($flag, 10), time());
        } elseif (!in_array($flag, ['--named', '--json'], true) || count(array_keys($flags, $flag, true)) > 1) {
            throw new \InvalidArgumentException("unknown or repeated option $flag; key-create <ref> [--expires=<when>] [--named] [--json]");
        }
    }
    if (count($refs) !== 1) {
        throw new \InvalidArgumentException('key-create takes one ref; run without arguments for usage');
    }
    $named = in_array('--named', $flags, true);
    $key = $ledger->createKey(arg($refs, 0), $expires, $named);
    return in_array('--json', $flags, true) ? json_encode(['ref' => $refs[0], 'key' => $key, 'expires_at' => $expires, 'named' => $named]) : $key;
}

/** @param list<string> $a */
function arg(array $a, int $i): string
{
    if (!isset($a[$i]) || $a[$i] === '') {
        throw new \InvalidArgumentException('missing argument; run without arguments for usage');
    }
    return $a[$i];
}

/** @param list<string> $a */
function intArg(array $a, int $i): int
{
    $v = arg($a, $i);
    if (!preg_match('/^-?[0-9]{1,16}$/', $v)) {
        throw new \InvalidArgumentException('expected an integer of at most 16 digits');
    }
    return (int) $v;
}

/**
 * An optional YYYY-MM-DD argument as the Unix time of that day's start in UTC, or null when absent.
 * @param list<string> $a
 */
function dateArg(array $a, int $i): ?int
{
    if (!isset($a[$i]) || $a[$i] === '') {
        return null;
    }
    $d = \DateTimeImmutable::createFromFormat('!Y-m-d', $a[$i], new \DateTimeZone('UTC'));
    if ($d === false || $d->format('Y-m-d') !== $a[$i]) {
        throw new \InvalidArgumentException('expected a date as YYYY-MM-DD');
    }
    return $d->getTimestamp();
}

/** Prints the verify summary; exits 1 when any balance disagrees with its credit log. */
function verifyOrExit(Ledger $ledger): string
{
    $r = $ledger->verify();
    if ($r['problems'] !== []) {
        fwrite(STDERR, implode("\n", $r['problems']) . "\n");
        echo json_encode($r), "\n";
        exit(1);
    }
    return json_encode($r);
}
